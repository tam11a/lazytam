// lazytam Waybar defaults. Don't edit: override in ~/.config/waybar/config.jsonc.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "bluetooth", "wireplumber", "cpu", "memory", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  wired",
    "format-disconnected": "  offline",
    "tooltip-format": "{ifname}  {ipaddr}",
    "on-click": "lazytam launch tui impala"
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disabled": "",
    "on-click": "lazytam launch tui bluetui"
  },
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "  mute",
    "format-icons": ["", "", ""],
    "on-click": "lazytam launch tui wiremix"
  },
  "cpu": {
    "format": "  {usage}%",
    "on-click": "lazytam launch tui btop"
  },
  "memory": {
    "format": "  {percentage}%",
    "on-click": "lazytam launch tui btop"
  },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "tray": {
    "spacing": 8
  }
}
