# Generated by lazytam from theme "{{theme_name}}". Override in ~/.config/fuzzel/fuzzel.ini.
[main]
font={{font}}:size={{font_size}}
terminal={{terminal_exec}}
prompt="> "
width=40
lines=12
horizontal-pad=20
vertical-pad=14
inner-pad=8

[colors]
background={{background.strip}}ee
text={{foreground.strip}}ff
prompt={{accent.strip}}ff
input={{bright_foreground.strip}}ff
match={{accent.strip}}ff
selection={{lighter_background.strip}}ff
selection-text={{bright_foreground.strip}}ff
selection-match={{accent.strip}}ff
border={{accent.strip}}ff

[border]
width=2
radius=12
