# Generated by lazytam from theme "{{theme_name}}". Override in ~/.config/tmux/tmux.conf.
set -g status-style "bg={{darker_background}},fg={{dark_foreground}}"
set -g status-left "#[bg={{accent}},fg={{background}},bold] #S #[default] "
set -g status-right "#[fg={{muted}}]#H #[fg={{foreground}}]%H:%M "
set -g window-status-format " #I:#W "
set -g window-status-current-format "#[bg={{lighter_background}},fg={{accent}},bold] #I:#W "
set -g pane-border-style "fg={{lighter_background}}"
set -g pane-active-border-style "fg={{accent}}"
set -g message-style "bg={{lighter_background}},fg={{foreground}}"
set -g mode-style "bg={{selection}},fg={{bright_foreground}}"
