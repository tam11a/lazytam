# Generated by lazytam from theme "{{theme_name}}". Override in ~/.config/hypr/hyprlock.conf.
general {
    hide_cursor = true
}

background {
    monitor =
    path = {{lock_background}}
    color = rgb({{background.strip}})
    blur_passes = 3
    blur_size = 7
    brightness = 0.6
}

input-field {
    monitor =
    size = 320, 52
    outline_thickness = 2
    rounding = 12
    outer_color = rgb({{accent.strip}})
    inner_color = rgba({{darker_background.strip}}cc)
    font_color = rgb({{foreground.strip}})
    check_color = rgb({{green.strip}})
    fail_color = rgb({{red.strip}})
    font_family = {{font}}
    placeholder_text = <span foreground="##{{muted.strip}}">password</span>
    fade_on_empty = false
    position = 0, -80
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgb({{bright_foreground.strip}})
    font_size = 96
    font_family = {{font}}
    position = 0, 140
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = rgb({{dark_foreground.strip}})
    font_size = 18
    font_family = {{font}}
    position = 0, 40
    halign = center
    valign = center
}
